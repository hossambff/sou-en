# --- Database (Supabase Postgres) ---
# Supabase dashboard → Connect → "Session pooler" URI (includes the DB password)
DATABASE_URL=

# --- Better Auth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=
# Only these emails can create an account (comma-separated)
ALLOWED_EMAILS=
# The learner (everyone else on the list is a cheerleader)
LEARNER_EMAIL=

# --- AI ---
# Anthropic API key (Claude = the coach's brain)
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5-5
# Safety cap on Claude calls per day
DAILY_LLM_CALL_LIMIT=600
# ElevenLabs (speech-to-text + the coach's voice). Without it, the app falls back to the browser's built-in voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_v3 = best Darija; eleven_flash_v2_5 = fastest
ELEVENLABS_TTS_MODEL=eleven_v3

# --- Push notifications (web push) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hossam.hamdy.go@gmail.com
# Protects /api/cron/* (sent as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# Timezone for days/weeks (Sou is in Morocco)
APP_TIMEZONE=Africa/Casablanca
